{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "apps/web/src/routeTree.gen.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["test/env.d.ts"],
      "rules": {
        "typescript/no-empty-object-type": [
          "error",
          {
            "allowInterfaces": "with-single-extends"
          }
        ]
      }
    },
    {
      "files": ["src/index.ts", "src/auction.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["log", "error"]
          }
        ]
      }
    }
  ]
}
