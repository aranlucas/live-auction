{
  "name": "gavel-live-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless run --name live-auction vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build && pnpm typecheck",
    "lint": "pnpm types && oxlint --deny-warnings --type-aware src test vite.config.ts vitest.config.ts vitest.render.config.ts",
    "typecheck": "pnpm types && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm run build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "pnpm run build && cf deploy --prebuilt --dry-run --mode production",
    "types": "cf workers types",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "cloudflare-live-auction": "workspace:*",
    "date-fns": "^4.4.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use-websocket": "^4.13.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-805ec1ff3",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.20",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
