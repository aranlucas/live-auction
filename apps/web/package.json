{
  "name": "gavel-live-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && tsc --noEmit",
    "lint": "oxlint --deny-warnings --type-aware src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "types": "wrangler types",
    "types:check": "wrangler types --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.168.49",
    "@tanstack/react-start": "^1.168.49",
    "cloudflare-live-auction": "workspace:*",
    "date-fns": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-use-websocket": "^4.13.0",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.131.1"
  }
}
