{
  "name": "cloudflare-live-auction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./model": "./src/model.ts"
  },
  "scripts": {
    "auth:keygen": "tsx scripts/auth-keygen.ts",
    "auth:token": "tsx scripts/auth-token.ts",
    "check": "pnpm types:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm openapi:check && pnpm test && pnpm --filter gavel-live-web build && pnpm --filter gavel-live-web deploy:dry-run && pnpm deploy:dry-run",
    "deploy": "pnpm build:worker && cf deploy --prebuilt",
    "deploy:dry-run": "pnpm build:worker && cf deploy --prebuilt --dry-run && pnpm build:worker --env staging && cf deploy --prebuilt --dry-run --mode staging",
    "deploy:staging": "pnpm build:worker --env staging && cf deploy --prebuilt --mode staging",
    "dev": "wrangler dev --experimental-new-config",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --type-aware src test scripts vitest.config.ts && pnpm --filter gavel-live-web lint",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "test": "vitest run && pnpm --filter gavel-live-web test",
    "test:production": "tsx scripts/production-integration.ts",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "build:worker": "wrangler build --experimental-new-config --experimental-cf-build-output"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "0.9.0",
    "hono": "4.13.8",
    "jose": "^6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.1",
    "@types/node": "26.2.0",
    "cf": "1.0.0-beta.10",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.143.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.22.0"
}
