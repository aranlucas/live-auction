{
  "compilerOptions": {
    "allowJs": false,
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["./.cloudflare/types/index.d.ts"]
  },
  "include": ["src/**/*.ts", ".cloudflare/types/index.d.ts"]
}
